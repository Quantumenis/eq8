{
  "name": "quilt-studio",
  "productName": "Quilt Studio",
  "version": "0.1.0",
  "description": "Quilt Studio — conception de quilts : blocs, dispositions, tissus et patrons à l'échelle.",
  "author": "Quilt Studio",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && playwright test --project=app",
    "e2e:dist": "playwright test --project=portable",
    "dist": "npm run build && node tools/dist.mjs",
    "icon": "node tools/make-icon.mjs"
  },
  "dependencies": {
    "clipper2-ts": "2.0.1",
    "fflate": "0.8.3",
    "opentype.js": "2.0.0",
    "pdf-lib": "1.17.1",
    "@pdf-lib/fontkit": "1.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "app.quiltstudio.desktop",
    "productName": "Quilt Studio",
    "copyright": "Quilt Studio",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quilt Studio",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "artifactName": "Quilt Studio Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "Quilt Studio ${version}.${ext}"
    }
  }
}
